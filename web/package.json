{
  "name": "mahjong-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Taiwanese mahjong (台灣麻將) in the browser: practice against computer players, analyze positions, play online, the engine as WebAssembly.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "strings": "node scripts/strings.mjs",
    "dev": "node scripts/strings.mjs && vite",
    "build": "node scripts/strings.mjs && svelte-check && vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "node tests/engine-native.mjs engine-files/engine.js",
    "test:lib": "for f in tests/*.test.mjs; do node \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0"
  }
}
