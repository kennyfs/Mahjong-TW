# The operators the app's network uses (opset 17, as python/mahjong/model.py exports the actor; later opsets too, for networks
# exported otherwise), plus Cast for float16 weights (python/fp16_weights.py: folded when the network loads) and the
# fused and split ones ONNX Runtime's optimizer makes of them at ORT_ENABLE_ALL. build-ort.sh builds a library with only
# these; a network with others fails to load until they are added here and the library is built again.
ai.onnx;17;Add,Cast,Concat,Constant,Div,Erf,Gather,Gemm,LayerNormalization,MatMul,Mul,ReduceMean,ReduceSum,Reshape,Shape,Sigmoid,Slice,Softmax,Split,Squeeze,Transpose,Unsqueeze
ai.onnx;18;Add,Cast,Concat,Constant,Div,Erf,Gather,Gemm,LayerNormalization,MatMul,Mul,ReduceMean,ReduceSum,Reshape,Shape,Sigmoid,Slice,Softmax,Split,Squeeze,Transpose,Unsqueeze
ai.onnx;19;Add,Cast,Concat,Constant,Div,Erf,Gather,Gemm,LayerNormalization,MatMul,Mul,ReduceMean,ReduceSum,Reshape,Shape,Sigmoid,Slice,Softmax,Split,Squeeze,Transpose,Unsqueeze
ai.onnx;20;Add,Cast,Concat,Constant,Div,Erf,Gather,Gemm,LayerNormalization,MatMul,Mul,ReduceMean,ReduceSum,Reshape,Shape,Sigmoid,Slice,Softmax,Split,Squeeze,Transpose,Unsqueeze
ai.onnx;21;Add,Cast,Concat,Constant,Div,Erf,Gather,Gemm,LayerNormalization,MatMul,Mul,ReduceMean,ReduceSum,Reshape,Shape,Sigmoid,Slice,Softmax,Split,Squeeze,Transpose,Unsqueeze
com.microsoft;1;BiasGelu,FusedMatMul,Gelu,SkipLayerNormalization
