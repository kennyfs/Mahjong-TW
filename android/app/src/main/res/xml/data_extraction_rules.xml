<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Everything is backed up and moved to a new phone as before, but the AI coach's API keys
     (coach/Keys.kt): encrypted by a Keystore key of this device, they could not be opened elsewhere, and should not
     travel. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="coach_keys.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="coach_keys.xml" />
  </device-transfer>
</data-extraction-rules>
